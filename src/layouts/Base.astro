---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SpaceXAI Hackathon Argentina",
  description = "SpaceXAI Hackathon Argentina — AI en la frontera. 70 builders, 48 horas a bordo del Tren Solar de la Quebrada, Jujuy.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content={description}>
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;700&display=swap">
</head>
<body>
<slot />
</body>
</html>
