---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SpaceXAI Hackathon Argentina · Tren Solar",
  description = "AI en la frontera. Un día a bordo del Tren Solar de la Quebrada, Jujuy. 70 builders. Un solo viaje. Sumate a la waitlist.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content={description}>
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,700;0,800;1,800;1,900&family=Figtree:wght@400;500;700;800&family=JetBrains+Mono:wght@500;700&display=swap">
</head>
<body>
<slot />
</body>
</html>
