---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import Hero from "../components/Hero.astro";
import Chapter from "../components/Chapter.astro";
import Marquee from "../components/Marquee.astro";
import Route from "../components/Route.astro";
import Hosts from "../components/Hosts.astro";
import Join from "../components/Join.astro";
import Signup from "../components/Signup.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <div class="stage" id="top">
    <Scene />

    <div class="stage-content">
      <Hero />

      <Chapter
        cam={1}
        id="que-es"
        stop="01 — Qué es"
        title="Construir AI para"
        em="entender el universo."
        text="La misión de SpaceXAI es acelerar el descubrimiento científico. Acá la bajamos a tierra: un hackathon de builders en Argentina, a bordo del Tren Solar. Empezando por la Quebrada."
        facts={[
          ["Build", "1 día"],
          ["Builders", "70"],
          ["Invitados", "35"],
          ["Tren", "1 solar"],
        ]}
      />

      <Chapter
        cam={2}
        id="experiencia"
        variant="right"
        stop="02 — Experiencia"
        title="Altura. Sol."
        em="Un deadline que se mueve con las vías."
        text="Salís de madrugada. Buildeás mientras cambia el paisaje. Presentás con los cerros de fondo."
        facts={[
          ["Tren", "Tren Solar de la Quebrada"],
          ["Tramo", "Volcán → Tilcara"],
          ["Altura", "2.500 m s. n. m."],
        ]}
      />

      <Chapter
        cam={3}
        stop="Etapas 01 · 02"
        title="Arranca el tren,"
        em="arranca el reloj."
        text="Embarcás con el brief en la mano. En el tramo largo buildeás con la ventana más linda de Argentina al costado, y los mentores circulan vagón por vagón."
        facts={[
          ["01", "La salida"],
          ["02", "El tramo largo"],
          ["Mentores", "Vagón por vagón"],
        ]}
      />

      <Chapter
        cam={4}
        variant="right"
        stop="Etapas 03 · 04"
        title="Demos con los"
        em="cerros de fondo."
        text="Cada proyecto se muestra frente a todos los que viajan. Todo pasa en un solo día."
        facts={[
          ["03", "Las demos"],
          ["04", "El cierre"],
          ["Duración", "Un solo día"],
        ]}
      />

      <Chapter
        cam={5}
        variant="center"
        stop="Última estación"
        title="Un día sin señal,"
        em="sin excusas."
        text="Solo vos, tu equipo y lo que puedan construir antes de la última estación. Nadie vuelve igual."
      />

    </div>
  </div>

  <Marquee />

  <main>
    <Route />
    <Hosts />
    <Join />
    <Signup />
    <Faq />
  </main>

  <Footer />

  <script>
    import "../scripts/main.js";
  </script>
</Base>
