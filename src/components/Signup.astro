---
import SignupButton from "./SignupButton.astro";
---

<section class="final" id="inscripcion">
  <div class="wrap">
    <div class="fcard">
      <div>
        <div class="eyebrow">Primera parada</div>
        <h3 class="sec">Subite antes de <em>que salga.</em></h3>
        <p>La Pre-Hackatón es el primer paso para viajar. Inscribite, sumá a tu equipo y empezá a darle forma a tu idea.</p>
        <div class="cta-row">
          <SignupButton />
        </div>
      </div>
      <div class="ticket" aria-hidden="true">
        <div class="t-h">SpaceXAI<br>Hackathon</div>
        <div class="t-r"><span>PASAJERO</span><span>BUILDER</span></div>
        <div class="t-r"><span>TRAMO</span><span>PRE-HACKATÓN</span></div>
        <div class="t-r"><span>TRACCIÓN</span><span>SOLAR</span></div>
        <div class="t-b">BUILD · INNOVATE · TRAVEL FURTHER</div>
      </div>
    </div>
  </div>
</section>
