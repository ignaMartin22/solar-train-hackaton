---
import SignupButton from "./SignupButton.astro";
---

<header class="hero">
  <div class="wrap hero-inner">
    <div class="topbar rise d1">
      <a class="mark" href="#top" aria-label="SpaceXAI Hackathon Argentina">
        <img src="/brand/wordmark-white.png" alt="SpaceX" width="196" height="24">
      </a>
      <nav class="topnav" aria-label="Secciones">
        <a href="#que-es">Qué es</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#hosts">Hosts</a>
        <a href="#como-se-entra">Cómo se entra</a>
        <a href="#faq">FAQ</a>
      </nav>
      <span class="topmeta">NOV 2026 · A CONFIRMAR</span>
    </div>
    <div class="copy">
      <div class="kicker rise d2"><i></i>SpaceXAI · Tren Solar · Jujuy</div>
      <h1 class="word rise d2"><span>SpaceXAI</span><span>Hackathon Argentina</span></h1>
      <div class="sub-k rise d3">AI en la frontera</div>
      <p class="lead rise d4">Un día a bordo del Tren Solar de la Quebrada. 70 builders. Un solo viaje.</p>
      <div class="cta-row rise d5">
        <a class="btn" href="#waitlist">
          Sumarme a la waitlist
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
        <SignupButton label="Soy de Jujuy: ir al Pre" ghost />
      </div>
    </div>
  </div>
</header>
