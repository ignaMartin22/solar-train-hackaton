---
// Boleto holográfico del cierre. Dos piezas (talón con arte + troquel hueso) que
// se inclinan en 3D con el puntero; la franja de foil la pinta un shader de vgpu
// (src/scripts/ticket.js) y, sin WebGPU, cae a un degradé CSS (.tk-foil).
// El arte del tren sale del boleto de referencia (public/ticket-art.jpg).

// barcode + QR decorativos, deterministas (no codifican nada)
let seed = 303;
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const bars: { x: number; w: number }[] = [];
for (let x = 0; x < 196; ) {
  const w = 1 + Math.floor(rnd() * 3.2);
  if (rnd() > 0.38) bars.push({ x, w });
  x += w + 1 + Math.floor(rnd() * 2);
}
const N = 25;
const finder = (r: number, c: number) => {
  for (const [fr, fc] of [[0, 0], [0, N - 7], [N - 7, 0]]) {
    const y = r - fr, x = c - fc;
    if (y >= 0 && y < 7 && x >= 0 && x < 7) {
      const ring = Math.max(Math.abs(y - 3), Math.abs(x - 3));
      return ring !== 2 ? 1 : 0;
    }
    if (y >= -1 && y <= 7 && x >= -1 && x <= 7) return 0; // quiet zone around finders
  }
  return -1;
};
const qr: [number, number][] = [];
for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
  const f = finder(r, c);
  if (f === 1 || (f === -1 && rnd() > 0.52)) qr.push([c, r]);
}
---

<div class="tk-scene" role="img" aria-label="Boleto holográfico del Hackatón Tren Solar: destino Hackatón Tren Solar, vagón 01, asiento 303, gate HTS, hacker ID JDV-2026-001. Jujuy, Argentina.">
  <div class="tk" aria-hidden="true">
    <div class="tk-shadow"></div>

    <div class="tk-stub">
      <img class="tk-art" src="/ticket-art.jpg" alt="" width="595" height="395" loading="lazy" decoding="async">
      <svg class="tk-ridges" viewBox="0 0 300 120" preserveAspectRatio="none">
        <path d="M0 70 32 52 58 64 92 30 128 58 160 44 196 66 236 40 270 60 300 48" />
        <path d="M0 92 40 76 70 86 104 58 140 82 176 70 214 90 250 72 300 84" />
        <path d="M0 110 50 98 88 106 126 90 168 104 210 96 252 108 300 100" />
      </svg>
      <div class="tk-foil"></div>
      <canvas class="tk-holo"></canvas>

      <div class="tk-title">
        <div class="tk-h">Hackatón <span>/</span><br>Tren Solar</div>
        <div class="tk-tag">Ideas que viajan más lejos</div>
        <div class="tk-loc">Jujuy · Argentina</div>
      </div>

      <div class="tk-band">
        <svg class="tk-solar" viewBox="0 0 64 44" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="18" cy="14" r="6.5" fill="currentColor" stroke="none" />
          <path d="M18 2v4M18 22v4M6 14h4M26 14h4M9.5 5.5l2.8 2.8M23.7 19.7l2.8 2.8M9.5 22.5l2.8-2.8M23.7 8.3l2.8-2.8" />
          <path d="M8 42l10-14h22L30 42z" /><path d="M13 35h22M23 28l-6 14" />
          <path d="M40 40l10-30h10L50 40z" fill="currentColor" fill-opacity=".25" /><path d="M45 25h10" />
        </svg>
        <i></i>
        <div class="tk-pillars">Energía solar<br>Tecnología<br>Comunidad</div>
      </div>
      <i class="tk-corners"></i>
      <i class="tk-slash"></i>
      <i class="tk-glare"></i>
    </div>

    <div class="tk-coin">
      <svg viewBox="0 0 100 100">
        <path class="c-code" d="M40 23l-7 7 7 7M60 23l7 7-7 7M54 20l-8 20" />
        <text x="50" y="60" text-anchor="middle">jujuy.dev</text>
        <path class="c-mnt" d="M32 80l9-11 6 6 8-10 13 15" />
      </svg>
    </div>

    <div class="tk-stubR">
      <div class="tk-admit"><span>Admit one <b>/</b></span>
        <svg viewBox="0 0 60 22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 20 18 4l9 9 7-7 13 11M40 10l5-4 14 14" /></svg>
      </div>
      <dl class="tk-grid">
        <div class="tk-dest"><dt>Destino:</dt><dd>Hackatón Tren Solar</dd></div>
        <div><dt>Vagón</dt><dd class="big">01</dd></div>
        <div><dt>Asiento</dt><dd class="big">303</dd></div>
        <div><dt>Gate</dt><dd>HTS</dd></div>
        <div><dt>Hacker ID</dt><dd>JDV-2026-001</dd></div>
      </dl>
      <div class="tk-codes">
        <svg class="tk-bar" viewBox="0 0 196 48" preserveAspectRatio="none">
          {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="48" />)}
        </svg>
        <svg class="tk-qr" viewBox={`-1 -1 ${N + 2} ${N + 2}`} shape-rendering="crispEdges">
          {qr.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
        </svg>
      </div>
      <div class="tk-foot">Jujuy · Argentina <b>/</b></div>
      <i class="tk-corners"></i>
      <i class="tk-glare"></i>
    </div>
  </div>
</div>

<script>
  import "../scripts/ticket.js";
</script>
